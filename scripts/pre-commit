#!/bin/bash
# FlowSight Pre-commit Hook
#
# 🔴 关键：这是防止问题代码进入仓库的最后防线
#
# 安装方式：
#   cp scripts/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# 或者运行安装脚本：
#   ./scripts/install-hooks.sh

set -e

echo "🔍 FlowSight Pre-commit Checks"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 检查是否有测试文件被修改
TESTS_CHANGED=$(git diff --cached --name-only | grep -E '\.(spec|test)\.(ts|tsx)$' || true)
RUST_CHANGED=$(git diff --cached --name-only | grep -E '\.rs$' || true)
FRONTEND_CHANGED=$(git diff --cached --name-only | grep -E '\.(ts|tsx)$' | grep -v '\.spec\.' | grep -v '\.test\.' || true)

# 1. Rust 格式检查
if [ -n "$RUST_CHANGED" ]; then
    echo ""
    echo "📦 Checking Rust formatting..."
    if ! cargo fmt --all -- --check 2>/dev/null; then
        echo -e "${RED}❌ Rust formatting check failed${NC}"
        echo "   Run: cargo fmt --all"
        exit 1
    fi
    echo -e "${GREEN}✅ Rust formatting OK${NC}"
fi

# 2. Rust 关键测试（数据正确性）
if [ -n "$RUST_CHANGED" ]; then
    echo ""
    echo "🔴 Running Rust data correctness tests..."
    if ! cargo test --package flowsight-analysis --test data_correctness_test 2>/dev/null; then
        echo -e "${RED}❌ Data correctness tests failed!${NC}"
        echo "   This is critical - UI may show incorrect data"
        exit 1
    fi
    echo -e "${GREEN}✅ Data correctness tests passed${NC}"
fi

# 3. TypeScript 类型检查
if [ -n "$FRONTEND_CHANGED" ] || [ -n "$TESTS_CHANGED" ]; then
    echo ""
    echo "📝 Checking TypeScript types..."
    cd app
    if ! pnpm typecheck 2>/dev/null; then
        echo -e "${RED}❌ TypeScript type check failed${NC}"
        exit 1
    fi
    echo -e "${GREEN}✅ TypeScript types OK${NC}"
    cd ..
fi

# 4. 测试质量检查
if [ -n "$TESTS_CHANGED" ]; then
    echo ""
    echo "🔍 Running test quality check..."
    cd app
    if ! npx tsx tests/scripts/quality-check.ts 2>/dev/null; then
        echo -e "${RED}❌ Test quality check failed${NC}"
        echo "   Please ensure tests have proper assertions"
        exit 1
    fi
    echo -e "${GREEN}✅ Test quality OK${NC}"
    cd ..
fi

# 5. 快速单元测试（如果修改了核心代码）
CORE_CHANGED=$(git diff --cached --name-only | grep -E 'crates/(flowsight-parser|flowsight-analysis)/src/' || true)
if [ -n "$CORE_CHANGED" ]; then
    echo ""
    echo "🧪 Running quick unit tests..."
    if ! cargo test --package flowsight-parser --package flowsight-analysis --lib 2>/dev/null; then
        echo -e "${RED}❌ Unit tests failed${NC}"
        exit 1
    fi
    echo -e "${GREEN}✅ Unit tests passed${NC}"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
echo ""
